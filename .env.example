# ==============================================================================
# Smart Start — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# For production deployments (e.g. Koyeb, Render, Railway), configure these
# variables in your platform dashboard.
# ==============================================================================

# --- Application Server & Environment -----------------------------------------
# Environment mode: "production" or "development".
# In production: secure cookies are enforced, and production headers are activated.
APP_ENV=production

# Server listening port (Platform default: Koyeb/Render usually provide $PORT or 8000).
PORT=8000

# Canonical public URL of your deployment (NO trailing slash).
# Used for SEO tags, sitemap.xml, robots.txt, and Telegram notification links.
# Example: https://smartstart.uz or https://your-service.koyeb.app
SITE_URL=https://smartstart.uz

# Cryptographic secret key used for signing JWT access/refresh tokens.
# Must be at least 32 characters long. In production, ALWAYS specify a strong secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_secure_random_key_min_32_chars_long

# Application log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Database Configuration ---------------------------------------------------
# Database connection string.
# Leave blank to use local SQLite: data/smartstart.db (requires persistent disk).
# For production PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql://smartstart:StrongPassword123@ep-cool-db.us-east-1.aws.neon.tech/smartstart?sslmode=require
DATABASE_URL=

# Automatically seed demo/initial data if the database is brand new and empty (true/false).
AUTO_SEED=true

# --- File Storage & Media -----------------------------------------------------
# Storage directory for local SQLite database, logs, and backups.
DATA_DIR=/app/data

# Directory for user-uploaded media files (photos, albums, documents).
MEDIA_ROOT=/app/media

# Automated backup storage directory.
BACKUP_DIR=/app/data/backups

# Number of database backup files to retain before rotating out.
BACKUP_KEEP=30

# Maximum file upload size in Megabytes.
MAX_UPLOAD_MB=15

# --- Security & Network -------------------------------------------------------
# Allowed Cross-Origin Resource Sharing (CORS) origins, comma-separated.
# In production, set to your frontend domain(s) or leave blank if served from same origin.
CORS_ORIGINS=https://smartstart.uz

# Set to "true" if running behind a reverse proxy / load balancer (Koyeb, Cloudflare, Nginx)
# to correctly trust X-Forwarded-For client IPs and X-Forwarded-Proto HTTPS schemes.
TRUST_PROXY=true

# Enforce secure HTTPS-only cookies (true/false). Leave blank to auto-detect based on APP_ENV.
COOKIE_SECURE=true

# Access token validity in minutes (default: 15).
ACCESS_TOKEN_MINUTES=15

# Refresh token validity in days (default: 30).
REFRESH_TOKEN_DAYS=30

# Enable request rate limiting (true/false).
RATE_LIMIT_ENABLED=true

# Content-Security-Policy header toggle (true/false) and optional custom override.
CSP_ENABLED=true
CONTENT_SECURITY_POLICY=

# --- Integrations (Optional) --------------------------------------------------
# Telegram bot integration: forwards admission inquiries & contact messages to staff.
# Bot token from @BotFather, Chat ID of staff group (e.g. -1001234567890).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Eskiz.uz SMS integration for automated SMS receipts to applicants.
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Cloudflare Turnstile bot protection for public submission forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Analytics Tracking IDs (Optional)
GA4_ID=
YM_ID=
META_PIXEL_ID=

# Error Monitoring (Optional - pip install sentry-sdk)
SENTRY_DSN=

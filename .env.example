# =====================================================================
#  Smart Start — sozlamalar fayli
#  Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zgartiring.
#  (run.sh / run.bat birinchi ishga tushganda nusxani o'zi yaratadi.)
#  "#" bilan boshlangan qatorlar — izoh, dastur ularni o'qimaydi.
# =====================================================================

# --- Umumiy ---------------------------------------------------------
# Rejim: development (sinov) yoki production (haqiqiy sayt).
# production'da cookie'lar faqat HTTPS orqali yuboriladi.
APP_ENV=development

# Saytning to'liq manzili (oxirida "/" siz). SEO, sitemap va Telegram tugmalari uchun.
# Masalan: https://smartstart.uz
SITE_URL=http://localhost:8000

# Maxfiy kalit (tokenlarni imzolash uchun). Bo'sh qoldirsangiz, dastur o'zi yaratib
# data/.secret_key fayliga saqlaydi (faqat development). Production: kamida 32 bayt.
SECRET_KEY=

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Ma'lumotlar bazasi ---------------------------------------------
# Bo'sh bo'lsa — SQLite: data/smartstart.db (hech narsa o'rnatish shart emas).
# PostgreSQL uchun misol:
# DATABASE_URL=postgresql://smartstart:parol@localhost:5432/smartstart
DATABASE_URL=

# Baza bo'sh bo'lsa, birinchi ishga tushishda demo/boshlang'ich ma'lumotlar yuklansinmi (true/false)
AUTO_SEED=false

# --- Fayllar va zaxira nusxalar --------------------------------------
# Ma'lumotlar papkasi (baza, loglar, zaxiralar)
DATA_DIR=./data
# Yuklangan rasmlar papkasi (public — saytda ko'rinadi, private — faqat xodimlar uchun)
MEDIA_ROOT=./media
# Zaxira nusxalar papkasi
BACKUP_DIR=
# Nechta oxirgi zaxira nusxa saqlansin
BACKUP_KEEP=30
# Yuklanadigan faylning maksimal hajmi (MB)
MAX_UPLOAD_MB=15

# --- Xavfsizlik -----------------------------------------------------
# Saytga boshqa domendan murojaat qilishga ruxsat berilgan manzillar (vergul bilan).
# Frontend dasturchisi uchun: http://localhost:5173. Production'da odatda bo'sh qoldiriladi
# yoki https://smartstart.uz yoziladi.
CORS_ORIGINS=

# Cookie faqat HTTPS orqali yuborilsinmi. Bo'sh = production'da ha, development'da yo'q.
COOKIE_SECURE=

# Sayt Nginx/Caddy orqasida ishlasa true qiling (mijozning haqiqiy IP manzilini olish uchun)
TRUST_PROXY=false
# Faqat ishonchli proksi IP/CIDR ro‘yxati (vergul bilan).
FORWARDED_ALLOW_IPS=127.0.0.1

# Access token muddati (daqiqa) va refresh token muddati (kun)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# So'rovlar sonini cheklash (spamdan himoya). Faqat sinov uchun false qilinadi.
RATE_LIMIT_ENABLED=true

# Content-Security-Policy sarlavhasi (true/false) va kerak bo'lsa o'z qiymatingiz
CSP_ENABLED=true
CONTENT_SECURITY_POLICY=

# --- Telegram bot (yangi arizalar menejerlar guruhiga keladi) -----------
# Bu qiymatlarni admin paneldagi "Sozlamalar" sahifasidan ham kiritish mumkin
# (admin panelda kiritilgan qiymat ustun turadi).
# Bot token — @BotFather beradi. Chat ID — guruh ID si (odatda -100... bilan boshlanadi).
# Bir nechta chat bo'lsa vergul bilan yozing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Eskiz.uz SMS (ixtiyoriy: ota-onaga "arizangiz qabul qilindi" SMS) ---
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (Eskiz'da tasdiqlangan bo'lishi kerak). Standart: 4546
ESKIZ_FROM=4546

# --- Cloudflare Turnstile (formalarni botlardan himoya qilish) -----------
# SECRET kiritilsa, arizalar faqat Turnstile tekshiruvidan o'tganda qabul qilinadi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Analitika (bo'sh bo'lsa, saytga qo'shilmaydi) ------------------
# Google Analytics 4 (G-XXXXXXX), Yandex Metrika (raqam), Meta Pixel (raqam)
GA4_ID=
YM_ID=
META_PIXEL_ID=

# --- Monitoring (ixtiyoriy) -----------------------------------------
# Sentry DSN. Ishlatish uchun qo'shimcha: pip install sentry-sdk
SENTRY_DSN=
